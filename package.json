{
  "name": "my-campus-to-career",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "engines": {"node": ">=22.12.0"},
  "overrides": {"deepmerge-ts": "8.0.0", "mysql2": "3.24.5", "body-parser": "2.4.0", "multer": "2.5.0", "fast-uri": "3.1.9"},
  "dependencies": {"@nestjs/platform-express": "12.1.3"},
  "devDependencies": {"prisma": "7.10.0"},
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "db:status": "node scripts/postgres.mjs status",
    "db:migrate": "npm run prisma:migrate --workspace=@campus/api",
    "db:seed": "npm run prisma:seed --workspace=@campus/api",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@campus/web",
    "dev:api": "npm run dev --workspace=@campus/api",
    "build": "npm run build --workspace=@campus/api && npm run build --workspace=@campus/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@campus/api",
    "test:mail": "npm run test:mail --workspace=@campus/api",
    "test:documents": "npm run test:documents --workspace=@campus/api",
    "test:profile-pictures": "npm run test:profile-pictures --workspace=@campus/api",
    "test:talent": "npm run test:talent --workspace=@campus/api",
    "test:gmail-auth": "node --test scripts/tests/gmail-oauth.test.mjs",
    "gmail:authorize": "node scripts/gmail-authorize.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "generate": "npm run prisma:generate --workspace=@campus/api"
  }
}
